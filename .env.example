TARGET_URL=http://example.invalid
AUTH_USERNAME=changeme
AUTH_PASSWORD=changeme

# Optional — only needed if the `tesseract` binary isn't on PATH (§3.19 OCR).
# Leave unset to auto-detect PATH, then common Windows install locations.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional — §3.33 GeoIP-gated page bypass. Only used for the specific
# hardcoded paths in config.py's GEO_BYPASS_PATHS (currently just
# /status/eu-region/, confirmed to do a real GeoIP lookup against the
# actual TCP source IP, not a spoofable header). Leave unset to skip this
# vector entirely — it's a no-op without a proxy configured, never blocks
# the rest of the crawl. Format: http://host:port or socks5://host:port.
# Whatever you put here receives your Basic Auth credentials in plaintext —
# only use a proxy you trust.
# GEO_BYPASS_PROXY=http://host:port
